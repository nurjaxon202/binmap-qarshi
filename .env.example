# BinMap Uzbekistan — environment template.
# Copy to .env.local and fill in. Never commit .env.local.
#
# With NOTHING set, the app runs entirely locally: PostgreSQL via PGlite in
# .data/pgdata, its own password authentication, and photo storage on disk.
# That is the development default and needs no external account.

# ---------------------------------------------------------------- database --
# PostgreSQL is the authoritative database in every mode. Set this and the app
# talks to a real server; leave it empty and it uses the local PGlite instance
# (the same PostgreSQL engine, compiled to WebAssembly).
#
# For Supabase, use the POOLER connection string (port 6543, transaction mode).
# A direct connection will exhaust the database's connection limit on a
# serverless platform.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set to false only for a local, plaintext PostgreSQL server.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=6

# Applies pending migrations on first connection. Development convenience only;
# it is ignored when NODE_ENV=production, where migrations run in deploy.
# BINMAP_AUTO_MIGRATE=true

# Local PGlite data directory (used only when DATABASE_URL is empty).
# BINMAP_LOCAL_PG_DIR=.data/pgdata

# ---------------------------------------------------------------- Supabase --
# Supplying all three switches authentication to Supabase Auth and photo
# storage to Supabase Storage. The service-role key is server-only and must
# never be exposed to the browser.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Two buckets are required. Create them in the Supabase dashboard:
#   bin-photos    PUBLIC  — photographs of approved, published bins
#   bin-evidence  PRIVATE — submission photos and report evidence
# SUPABASE_BIN_PHOTO_BUCKET=bin-photos
# SUPABASE_EVIDENCE_BUCKET=bin-evidence

# ---------------------------------------------------- local file storage ----
# Used when Supabase is not configured.
# BINMAP_UPLOAD_DIR=.data/uploads
# Signs short-lived URLs for private photos. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated once and persisted beside the uploads.
# BINMAP_MEDIA_SIGNING_SECRET=
# BINMAP_SIGNED_URL_TTL=600

# ----------------------------------------------------------------- uploads --
# BINMAP_MAX_UPLOAD_BYTES=6291456

# --------------------------------------------------------------- geography --
# The city the map opens on. Cities are rows in public.cities, not code.
# BINMAP_DEFAULT_CITY=qarshi

# --------------------------------------------------------------- map tiles --
# OpenStreetMap *data* and the OpenStreetMap Foundation *tile servers* are
# different things. The default is CARTO's OSM-derived basemap, which is
# published for third-party sites. The OSMF servers are community-funded and
# are not a production CDN — point this at your own provider for real traffic.
# Tiles are always fetched on demand and never bulk-downloaded.
# BINMAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# BINMAP_TILE_LABEL=
# BINMAP_TILE_ATTRIBUTION=
# BINMAP_TILE_MAX_ZOOM=19
# Or pick a built-in: "osm" for the OSMF servers (development only).
# BINMAP_TILE_PROVIDER=

# --------------------------------------------------------------- geocoding --
# Place search is optional; the map works fully without it. Set to "none" to
# disable it and let people choose a point on the map instead.
# Nominatim's usage policy forbids autocomplete, which is why search in this
# app requires an explicit submit. Supply a contact address if you use it.
# BINMAP_GEOCODER=nominatim
# BINMAP_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# BINMAP_GEOCODER_EMAIL=
# BINMAP_GEOCODER_USER_AGENT=BinMapUzbekistan/0.1 (https://your-domain; you@example.com)

# -------------------------------------------------------------- directions --
# Where "Yo‘l ko‘rsatish" sends people: google | yandex | 2gis | osm
# BINMAP_DIRECTIONS_PROVIDER=google

# ------------------------------------------------------------------- demo ---
# Guards `npm run demo:seed`. It refuses to run when NODE_ENV=production
# unless this is explicitly true. Never enable it on a production deployment:
# demonstration records must not appear as real verified locations.
# BINMAP_ALLOW_DEMO_SEED=false

# ------------------------------------------------------------------- site ---
# Used for absolute URLs in metadata and in password-reset links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CONTACT_EMAIL=info@binmap.uz
